# ── Python ────────────────────────────────────────────────────────────────────
venv/
.venv/
env/
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
*.egg-info/
dist/
build/

# ── Large generated data files (recreated by running the pipeline) ────────────
# Raw feature matrices (20-35 MB each — too large for git)
data/processed/*.csv
# Serialised models & preprocessors
data/processed/*.pkl
data/processed/*.joblib
artifacts/models/**/*.pkl
artifacts/models/**/*.joblib
# Keep metadata and feature column lists (small, informative)
!artifacts/models/**/metadata.json
!artifacts/models/**/feature_cols.json
!artifacts/models/active_model.txt

# ── MLflow ────────────────────────────────────────────────────────────────────
mlruns/
mlflow.db

# ── Database (regenerated by pipeline) ───────────────────────────────────────
data/maintenance.db

# ── Logs (regenerated each run) ───────────────────────────────────────────────
logs/*.log

# ── Reports (binary — track separately if needed) ────────────────────────────
# Keep design_document.md and PDF; exclude PPTX binaries
reports/round1/*.pptx

# ── OS & IDE ──────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/settings.json
.idea/

# ── Secrets ───────────────────────────────────────────────────────────────────
*.env
secrets.yaml
